[resource]
script = ExtResource("1_data")
level_name = "Market Run"
map = "harbour"
short_goal = "From the lighthouse cottage across the harbour, low along the harbour wall to the fish crates."
goal_text = "Throw from the roof of the lighthouse keeper's cottage and glide right across the harbour, riding the warm air, then curve round in front of the boathouse and come down to the water. Skim low along the stone harbour wall, slip under the end of the pier between its posts, then hop up onto the quay past the market stalls and settle in front of the fish crates by the crane. Keep low but don't touch the water, and come in slow or you'll bump into the crates. Follow the dotted line and fly through the rings."
