script = ExtResource("1_data")
level_name = "Lighthouse to Lighthouse"
map = "harbour"
short_goal = "The grand finale: the whole harbour, once round the green lighthouse, home to the red one."
goal_text = "The grand finale! Throw from the hilltop lookout and dive down the lane, then fly along the quay to the old boathouse and straight through it. Slip under the pier, through the ferry's cabin windows, ride the warm air up over the breakwater and out into the sea breeze. Circle once round the little green lighthouse on its rock to climb, then fly home and land on the doorstep of the red lighthouse. Follow the dotted line and fly through the rings."
