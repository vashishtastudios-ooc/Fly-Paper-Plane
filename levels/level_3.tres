[resource]
script = ExtResource("1_data")
level_name = "Up to the Clock Tower"
short_goal = "Slip through Mill Lane, skim the millpond, then climb to the clock tower."
goal_text = "Launch from the bakery roof and slip through the Mill Lane archway to the millpond behind the shops. Skim low along the water, under the bunting and the wooden footbridge (water sinks the air, so keep your speed up), then circle in the warm air at the far end to climb. Cross into the square, circle up over the fountain and settle gently onto the stone balcony of the clock tower. Follow the dotted line and fly through the gold rings to find the way."
