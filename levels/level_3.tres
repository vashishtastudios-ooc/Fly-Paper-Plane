[resource]
script = ExtResource("1_data")
level_name = "Up to the Clock Tower"
short_goal = "Slip through Mill Lane, skim under the millpond footbridge, then climb to the clock tower."
goal_text = "Launch from the bakery roof and slip through the Mill Lane archway. Turn right onto the millpond through the warm air in the bend, then skim low down the water and under the wooden footbridge (water sinks the air, so keep your speed up). Circle once in the rising air past the pond, then ride the updrafts behind the shops, over the fountain and by the tower, and settle gently onto the stone balcony of the clock tower. Follow the dotted line and fly through the gold rings to find the way."
