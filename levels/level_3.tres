[resource]
script = ExtResource("1_data")
level_name = "Up to the Clock Tower"
short_goal = "Through Mill Lane, under the millpond bridge, through the flower shop and up to the clock tower."
goal_text = "Launch from the bakery roof and slip through the Mill Lane archway. Turn right onto the millpond through the warm air in the bend, then skim low down the water and under the wooden footbridge (water sinks the air, so keep your speed up). Ride the rising air up to the flower shop's open upstairs window and fly straight through it, out over Market Street and up over the rooftops. Glide behind the shops into the square, through the warm air by the tower, and settle gently onto the stone balcony of the clock tower. Follow the dotted line and fly through the blue rings to find the way."
