[resource]
script = ExtResource("1_data")
level_name = "Lantern Night"
short_goal = "At dusk, weave down Market Street, under the old bridge, and land on the lantern raft."
goal_text = "The town is lit up for the lantern festival. Throw from the clock tower balcony and glide down Market Street, over some lantern strings and under others. Warm air rising from the lanterns will carry you up, so circle in it to stay high. At the end of the street, swing out over the river bank, drop down to the water and thread the old stone arch, then land on the little lantern raft moored on the other side. Follow the dotted line and fly through the lantern hoops to find the way."
