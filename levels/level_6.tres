[resource]
script = ExtResource("1_data")
level_name = "Open House Day"
short_goal = "Fly through open windows and doors, room to room, and land on the cat's rug."
goal_text = "It's spring-cleaning day on Rowan Row and every window is thrown open! Launch from the attic bedroom and out the gable window, into the bedroom next door and through to the study. Cross the garden over the washing, then glide along the landing, over the banister and down the stairwell, out through the french doors. Weave through the greenhouse, slip in the cottage's back door and settle on the cat's rug by the fire. Mind the closed windows and the hanging lamps. The pink ring in the little hatch beside the bedroom door is an optional secret shortcut (+300). Follow the dotted line and fly through the gold rings to find the way."
