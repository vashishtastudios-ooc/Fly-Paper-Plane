script = ExtResource("1_data")
level_name = "Willow Close"
short_goal = "From the treehouse, room to room down Willow Close to the dog's bed."
goal_text = "It's a sleepover on Willow Close and every house has its windows open! Throw from the treehouse into the library's upstairs window, swoop down past the tall bookshelves and out the low window. Skim the paddling pool, zip through the garage over the little red car and out the back window, then ride the barbecue smoke. In through the hall's garden doors, let the warm air lift you up the stairwell and out the upstairs window, hop over the washing, and land in Biscuit's bed in the den. Mind the bookshelves, the lamps and the closed windows. Follow the dotted line and fly through the blue rings."
