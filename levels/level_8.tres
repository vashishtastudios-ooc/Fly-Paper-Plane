[resource]
script = ExtResource("1_data")
level_name = "The Grand Tour"
short_goal = "Dive from Skyline Apartments and tour the whole town to Grandpa's boat."
goal_text = "The longest flight of all! Throw from the roof of Skyline Apartments and dive steeply past the school, through the column of rings. Sweep onto Linden Lane and glide its length on the rising air, under the bunting. Swoop into the park and fly right through the bandstand, between its posts and under the striped roof, then circle in the rising air and head back to the lane. At the end of the lane swing out over the bank, drop to the river, thread the old bridge's arch and land in Grandpa's rowing boat. Follow the dotted line and fly through the blue rings."
