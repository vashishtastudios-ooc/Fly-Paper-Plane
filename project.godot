; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Glide Home"
config/description="Glide a folded notebook-paper plane across a golden-hour town and land it softly."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.984, 0.976, 0.949, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://autoload/settings.gd"
Game="*res://autoload/game.gd"
Audio="*res://autoload/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=false

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="LandingPads"

[physics]

common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/ssao/quality=1
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.96, 0.82, 0.67, 1)
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/msaa_3d.mobile=1
scaling_3d/scale.mobile=0.8
anti_aliasing/quality/screen_space_aa.mobile=0
