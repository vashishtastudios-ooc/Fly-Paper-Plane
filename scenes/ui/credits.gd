extends CanvasLayer
## Credits and open-source license notices (Godot Engine and bundled fonts).

signal closed

const STUDIO := "Vashishta Studios"

var _sheet: NotebookSheet
var _back: Button


func _ready() -> void:
	layer = 12
	var root := Control.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(root)
	var dim := ColorRect.new()
	dim.color = Color(0.15, 0.08, 0.02, 0.3)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	root.add_child(dim)
	_sheet = NotebookSheet.new()
	_sheet.tilt_degrees = 1.0
	root.add_child(_sheet)
	var v := VBoxContainer.new()
	v.add_theme_constant_override("separation", 8)
	_sheet.add_child(v)
	v.add_child(UIKit.label("Credits", UIKit.display_font(), 54, UIKit.INK))
	var scroll := ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	v.add_child(scroll)
	var body := RichTextLabel.new()
	body.bbcode_enabled = true
	body.fit_content = true
	body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	body.add_theme_font_override("normal_font", UIKit.body_font())
	body.add_theme_font_override("bold_font", UIKit.ui_font())
	body.add_theme_font_size_override("normal_font_size", 18)
	body.add_theme_font_size_override("bold_font_size", 22)
	body.add_theme_color_override("default_color", UIKit.INK_DARK)
	body.text = _credits_text()
	scroll.add_child(body)
	_back = UIKit.paper_button("Back", true, 28)
	_back.pressed.connect(func():
		close()
		closed.emit())
	v.add_child(_back)
	get_viewport().size_changed.connect(_layout)
	visible = false


func _credits_text() -> String:
	var t := "[b]%s[/b]\nA %s game.\n\n" % [ProjectSettings.get_setting("application/config/name"), STUDIO]
	t += "Every model, texture and sound in this game is generated by code at runtime.\n\n"
	t += "[b]Fonts[/b]\nCaveat Brush, Newsreader and Barlow Condensed are licensed under the SIL Open Font License 1.1 (license texts in the fonts folder).\n\n"
	t += "[b]Made with Godot Engine[/b]\nThis game uses Godot Engine, available under the following license:\n\n"
	t += Engine.get_license_text()
	t += "\n\nGodot Engine also includes third-party components; see godotengine.org/license.\n"
	return t


func open() -> void:
	visible = true
	_layout()
	_back.grab_focus()


func close() -> void:
	visible = false


func _layout() -> void:
	var s := Settings.viewport_size()
	_sheet.size = Vector2(minf(s.x - 24.0, 720.0), minf(s.y - 24.0, 680.0))
	_sheet.position = (s - _sheet.size) * 0.5
